# ── AI Congress environment configuration ──────────────────────────
# Copy to .env (gitignored) and fill in what applies to your setup.
# Every variable is optional — the app degrades gracefully without them.

# Ollama backend
OLLAMA_BASE_URL=http://127.0.0.1:11434

# OpenAI-compatible backend (OCA / LiteLLM / OpenAI) — optional
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# pi backend — deepseek-v4-flash (and friends) via opencode-go, cloud-hosted.
# Set the key to enable the "pi" inference backend; local Ollama stays
# available as the default. PI_BASE_URL/PI_MODEL override the defaults.
OPENCODE_GO_API_KEY=
PI_BASE_URL=https://opencode.ai/zen/go/v1
PI_MODEL=deepseek-v4-flash

# Oracle 26ai datalake — optional; without these the datalake is disabled
# and observability falls back to local JSONL/files.
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1
ORACLE_USER=ADMIN
ORACLE_PASSWORD=

# API server
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated allowed CORS origins (frontend dev server)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional API key for mutating endpoints (/api/feedback, /api/documents/*, ...)
# Leave empty to disable auth.
AI_CONGRESS_API_KEY=

# Rate limiting (4.9.6): requests per minute per client IP (default 60)
AICONGRESS_RATE_LIMIT=

# Cloud spend guard (4.9.5): cap pi/openai calls per run (default 12)
# and per process session (default 100)
# AICONGRESS_MAX_CLOUD_PER_RUN=12
# AICONGRESS_MAX_CLOUD_PER_SESSION=100

# Web search
WEB_SEARCH_DEFAULT_ENGINE=duckduckgo
SEARXNG_URL=
YACY_URL=

# Voice transcription (requires the `full` extras)
VOICE_MODEL=base
VOICE_DEVICE=cpu
